{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ':/apps/web' ':/packages' ':/package.json' ':/pnpm-lock.yaml' ':/pnpm-workspace.yaml' ':/turbo.json' ':/tsconfig.base.json'",
  "crons": [
    {
      "path": "/api/agent/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/self-improve",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/admin/spend-monitor",
      "schedule": "23 7 * * *"
    },
    {
      "path": "/api/admin/health-snapshot",
      "schedule": "40 8 * * *"
    },
    {
      "path": "/api/admin/purge-listens",
      "schedule": "41 3 * * *"
    },
    {
      "path": "/api/admin/social-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/notifications/push-drain",
      "schedule": "* * * * *"
    }
  ]
}
