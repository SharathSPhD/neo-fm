# apps/web environment

# --- Supabase (auto-provisioned by the Vercel <> Supabase Marketplace
#     integration; needed locally for `pnpm --filter @neo-fm/web dev`) ---
NEXT_PUBLIC_SUPABASE_URL=https://lsxicfgqtdxvlcivlwmd.supabase.co
# Either name works; the integration sets ANON_KEY. Newer Supabase projects
# call it the "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; NEVER expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags ---
# Prompt branch (Describe with AI tab) is live in v1.5. Set to "false"
# for emergency rollback only; omitting this var defaults to enabled.
# NEO_FM_PROMPT_BRANCH_ENABLED=false

# Email notifications (Resend)
RESEND_API_KEY=re_...
APP_URL=https://neo-fm-web.vercel.app

# --- Managed Agents pipeline (server-only; never NEXT_PUBLIC_) ---
# MA_ANTHROPIC_API_KEY=         # Console API key for Managed Agents (ANTHROPIC_API_KEY also works on Vercel)
# MA_ENVIRONMENT_ID=            # from managed-agents/claude-lock.json (environments/neo-fm-cloud.yaml)
# MA_AGENT_ID_FREE=             # producer-free
# MA_AGENT_ID_PRO=              # producer-pro
# GEMINI_API_KEY=               # Lyria only; no Gemini text models are used
# LYRIA_BUDGET_GBP=3            # hard cap enforced by public.reserve_spend (testing cap is GBP 4)
# LYRIA_COST_GBP_CLIP=0.05      # per-call estimates; set from AI Studio billing
# LYRIA_COST_GBP_FULL=0.25
# CRON_SECRET=                  # Vercel Cron bearer for /api/agent/tick
# SUPABASE_SERVICE_ROLE_KEY=

# House ads in the station queue (lib/station/ads.ts). Off unless exactly "1". Needs migration 0099 and a reviewed, active slot; free and signed-out listeners only.
# ADS_ENABLED=

# Personal tracks per month on the Station pass (default 4; each is ~USD 0.46). Becomes the per-user Lyria envelope for pass holders.
# STATION_PASS_MONTHLY_TRACKS=4
