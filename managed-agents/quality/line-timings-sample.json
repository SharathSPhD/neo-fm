 "kn-15": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ಹಿಮ ಕರಗಿ ಹರಿವ ಹಾದಿ ನೋಡುತಲಿ",
    "startS": 0,
    "endS": 5.3,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಕಾದಿದೆ ಈ ಬೆಟ್ಟದ ಹಳ್ಳಿಯು ಮೌನದಲಿ",
    "startS": 5.3,
    "endS": 11.1,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
