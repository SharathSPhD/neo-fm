 },
 "te-1": {
  "language": "Telugu",
  "lines": [
   {
    "i": 0,
    "text": "వెలుగు పూసిన వేళ నది అలలు పాడె",
    "startS": 0,
    "endS": 5,
    "cer": 0.04,
    "sung": true
   },
   {
    "i": 1,
    "text": "ఉదయరాగం వింటూ గుడి తలుపు తెరిచె",
    "startS": 5,
    "endS": 11,
    "cer": 0.037037037037037035,
    "sung": true
   },
   {
    "i": 2,
    "text": "నా అహమే కరిగి నీ ముందు ఒదిగిపోయె",
    "startS": 11,
    "endS": 16,
    "cer": 0.07407407407407407,
    "sung": true
   },
   {
    "i": 3,
    "text": "కృతజ్ఞత కర్పూరమై మనసులో వెలిగె",
    "startS": 16,
    "endS": 20.833333333333332,
    "cer": 0.07407407407407407,
    "sung": true
   },
   {
    "i": 4,
    "text": "నీ చరణమే శరణని తల వంచి నిలిచాను",
