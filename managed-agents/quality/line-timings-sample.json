 "kn-12": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ಕಡಲ ತೀರದ ಮುಂಜಾವಿನಲಿ ಬೆಳಕು ಹರಿದಿದೆ",
    "startS": 0,
    "endS": 5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ದೋಣಿ ಮರಳುವ ಆಸೆ ಇನ್ನೂ ಜೀವದಲಿ ಉಳಿದಿದೆ",
    "startS": 5,
    "endS": 11,
    "cer": 0.03333333333333333,
    "sung": true
   },
   {
    "i": 2,
    "text": "ಉಪ್ಪುಗಾಳಿ ನೇಯ್ದ ಬಲೆಯ ಮೇಲೆ ಮಂಜಿನ ಹನಿ ಮಿನುಗಿದೆ",
    "startS": 11,
    "endS": 17,
    "cer": 0.02631578947368421,
    "sung": true
   },
   {
    "i": 3,
    "text": "ಒದ್ದೆ ಮರಳಿನ ಮೇಲೆ ನಿನ್ನ ಹೆಜ್ಜೆಯ ಗುರುತು ಉಳಿದಿದೆ",
    "startS": 17,
    "endS": 22,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "ಹಾಡು ನಿಂತ ಮನೆಯ ಬಾಗಿಲು ಇಂದೂ ತೆರೆದೇ ಇದೆ",
    "startS": 22,
    "endS": 30,
    "cer": 0.03225806451612903,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
