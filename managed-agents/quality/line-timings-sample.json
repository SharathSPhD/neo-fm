{
 "bn-1": {
  "language": "Bengali",
  "lines": [
   {
    "i": 0,
    "text": "ভেসে আসে মেঘের ছায়া নদীর বাঁকে বাঁকে,",
    "startS": 0,
    "endS": 5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ঘাটের প্রদীপ একলা জাগে জলের ফাঁকে ফাঁকে।",
    "startS": 5,
    "endS": 10,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "দূর ঘাটে বাজে বাঁশি, ফেরে না কেউ আর,",
    "startS": 10,
    "endS": 16,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "মনের কোণে জমে নাম-না-জানা ভার।",
    "startS": 16,
    "endS": 21,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "বাদল-হাওয়া ডেকে যায় কাহার সুরে,",
    "startS": 21,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "ভেসে আসে মেঘের ছায়া নদীর বাঁকে বাঁকে"
   },
   {
    "startS": 5,
    "text": "ঘাটের প্রদীপ একলা জাগে জলের ফাঁকে ফাঁকে"
   },
   {
    "startS": 10,
    "text": "দূর ঘাটে বাজে বাঁশি, ফেরে না কেউ আর"
   },
   {
    "startS": 16,
    "text": "মনের কোণে জমে নাম-না-জানা ভার"
   },
   {
    "startS": 21,
    "text": "বাদল হাওয়া ডেকে যায় কাহার সুরে"
   }
  ]
 },
 "bn-10": {
  "language": "Bengali",
  "lines": [
   {
    "i": 0,
    "text": "ঢাকের বোলে পথ জাগে, নাচে বরের সারি",
    "startS": 0,
    "endS": 6.75,
    "cer": 0.14814814814814814,
    "sung": true
   },
   {
    "i": 1,
    "text": "হরি বলো মন, এলো গো আজ কন্যার বাড়ি",
    "startS": 7,
    "endS": 14,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ধানের খেতে বাতাস বয়, শঙ্খ ওঠে সুরে",
    "startS": 14,
    "endS": 20.53333333333333,
    "cer": 0.17857142857142858,
    "sung": true
   },
   {
    "i": 3,
    "text": "গোবিন্দ জপে মন, বধূ আছে দুয়ারে",
    "startS": 21,
    "endS": 26,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "আলপনা আঁকা উঠোনে, প্রদীপ জ্বলে সারে সারে",
    "startS": 26,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "ঢাকের বোলে পথ জাগে নাচে বনের শাড়ি"
   },
   {
    "startS": 7,
    "text": "হরি বলো মন এলো গো আজ কন্যার বাড়ি"
   },
   {
    "startS": 14,
    "text": "ধানের ক্ষেতে বাতাস বয় শঙ্খ ওঠে সুরে"
   },
   {
    "startS": 21,
    "text": "গোবিন্দ জপে মন বধূ আছে দুয়ারে"
   },
   {
    "startS": 26,
    "text": "আলপনা আঁকা উঠোনে প্রদীপ জ্বলে সারে সারে"
   }
  ]
 },
 "hi-1": {
  "language": "Hindi",
  "lines": [
   {
    "i": 0,
    "text": "पटरी की लय, बीते दिन, खिड़की पर ठहरी धूप",
    "startS": 0,
    "endS": 5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "अनभेजे ख़त की स्याही, अब भी गीली धूप",
    "startS": 5,
    "endS": 12,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "पीपल वाला स्टेशन छूटा, छूटी वो पगडंडी",
    "startS": 12,
    "endS": 18,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "तेरी हँसी की लकीर, अब भी मुट्ठी में ठंडी",
    "startS": 18,
    "endS": 25,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "लौटूँगा जब उस गाँव, पूछूँगा तेरा पता",
    "startS": 25,
    "endS": 30,
    "cer": 0.034482758620689655,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "पटरी की लय बीते दिन खिड़की पर ठहरी धूप"
   },
   {
    "startS": 5,
    "text": "अनभेजे ख़त की स्याही अब भी गीली धूप"
   },
   {
    "startS": 12,
    "text": "पीपल वाला स्टेशन छूटा छूटी वो पगडंडी"
   },
   {
    "startS": 18,
    "text": "तेरी हँसी की लकीर अब भी मुट्ठी में ठंडी"
   },
   {
    "startS": 25,
    "text": "लौटूंगा जब उस गाँव पूछूँगा तेरा पता"
   }
  ]
 },
 "hi-10": {
  "language": "Hindi",
  "lines": [
   {
    "i": 0,
    "text": "भीगी बस की खिड़की से, घर की ओर चला मन,",
    "startS": 0,
    "endS": 5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "बारिश बोली \"रुक ज़रा\", प्रभु सुमिरूँ हर क्षण।",
    "startS": 4.454545454545455,
    "endS": 11,
    "cer": 0.11764705882352941,
    "sung": true
   },
   {
    "i": 2,
    "text": "धुँधले काँच पे उँगली से लिखूँ तेरा नाम,",
    "startS": 11,
    "endS": 16,
    "cer": 0.12903225806451613,
    "sung": true
   },
   {
    "i": 3,
    "text": "हर मोड़ पे तू थाम लेना, मेरे गाँव के राम।",
    "startS": 16,
    "endS": 21,
    "cer": 0.03333333333333333,
    "sung": true
   },
   {
    "i": 4,
    "text": "भीगी बस की खिड़की से, घर की ओर चला मन,",
    "startS": 21,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "भीगी बस की खिड़की से"
   },
   {
    "startS": 2,
    "text": "घर की ओर चला मन"
   },
   {
    "startS": 5,
    "text": "बारिश बोली रुक जरा"
   },
   {
    "startS": 8,
    "text": "प्रभु सुमिरू हर क्षण"
   },
   {
    "startS": 11,
    "text": "धुंधले कांच पे उंगली से लिखूं तेरा नाम"
   },
   {
    "startS": 16,
    "text": "हर मोड़ पे तू थाम लेना मेरे गांव के राम"
   },
   {
    "startS": 21,
    "text": "भीगी बस की खिड़की से"
   },
   {
    "startS": 24,
    "text": "घर की ओर चला मन"
   }
  ]
 },
 "kn-1": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ಅಂಗಳದ ತುಳಸಿ ನೆರಳು ಕರೆದಿದೆ",
    "startS": 0,
    "endS": 4.98,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಅಮ್ಮನ ಲಾಲಿ ಎದೆಯಲಿ ಉಸಿರಾಡಿದೆ",
    "startS": 4.98,
    "endS": 12.33,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ತೊಟ್ಟಿಲ ತೂಗಿದ ಕೈಗಳ ಬೆಚ್ಚನೆ ಹೊದಿಕೆ",
    "startS": 12.33,
    "endS": 18.5,
    "cer": 0,
    "sung": true
   },
   {
