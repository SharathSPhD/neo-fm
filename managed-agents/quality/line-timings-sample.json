 "kn-16": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ಹೊಲದ ಮಣ್ಣಿಗೆ ಬೆವರ ಸುರಿದೆ, ಕರುಣೆ ತೋರೋ ದೇವರೇ",
    "startS": 0,
    "endS": 4.6,
    "cer": 0.11428571428571428,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಕಣದ ತುಂಬ ರಾಶಿ ಹಾಕಿಸು, ಕಾಯುತ ನಿಲ್ಲೋ ದೇವರೇ",
    "startS": 5,
    "endS": 10,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ನೇಗಿಲ ಹೊತ್ತು ಎತ್ತಿನ ಜೊತೆಗೆ, ನಿನ್ನನೇ ನೆನೆವೆ ನಾನು",
    "startS": 10,
    "endS": 15,
    "cer": 0.025,
    "sung": true
   },
   {
    "i": 3,
    "text": "ಬಿತ್ತಿದ ಬೀಜಕೆ ಮಳೆಯ ಸುರಿಸು, ಅನ್ನದ ತಾಯೇ ಕಾಯೋ ನೀನು",
    "startS": 15,
    "endS": 19.75609756097561,
    "cer": 0.10256410256410256,
    "sung": true
   },
   {
    "i": 4,
    "text": "ಹಸಿರು ಸೀರೆ ಉಟ್ಟ ಹೊಲದಲಿ, ತೆನೆಯು ತೂಗಲಿ ದೇವರೇ",
    "startS": 20,
    "endS": 25,
    "cer": 0,
    "sung": true
   },
   {
    "i": 5,
    "text": "ಕೈ ಮುಗಿವೆನು ಕೃಷ್ಣ ದೇವ ನಿನಗೆ, ರೈತರ ಬಾಳು ಹಸನಾಗಲಿ",
    "startS": 25,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "ಹೊಲದ ಮಣ್ಣಿಗೆ ಬೆವರ ಸುರಿಸಿದೆ ಕರುಣೆ ತೋರೋ"
   },
   {
    "startS": 4,
    "text": "ದೇವರೇ"
   },
   {
    "startS": 5,
    "text": "ಕಣದ ತುಂಬ ರಾಶಿ ಹಾಕಿಸು ಕಾಯುತ ನಿಲ್ಲೋ"
   },
   {
    "startS": 9,
    "text": "ದೇವರೇ"
   },
   {
    "startS": 10,
    "text": "ನೇಗಿಲ ಹೊತ್ತು ಎತ್ತಿನ ಜೊತೆಗೆ ನಿನ್ನನೆ ನೆನೆವೆ ನಾನು"
   },
   {
    "startS": 15,
    "text": "ಬಿತ್ತಿದ ಬೀಜಕ್ಕೆ ಮಳೆಯ ಸುರಿಸು ಅನ್ನದ ತಾಯೇ ಕಾಯೋ ನೀನು"
   },
   {
    "startS": 20,
    "text": "ಹಸಿರು ಸೀರೆ ಉಟ್ಟ ಹೊಲದಲಿ ತೆನೆಯು ತೂಗಲಿ ದೇವರೇ"
   },
   {
    "startS": 25,
    "text": "ಕೈ ಮುಗಿವೆನು ಕೃಷ್ಣದೇವ ನಿನಗೆ ರೈತರ ಬಾಳು ಹಸನಾಗಲಿ"
   }
  ]
 },
 "kn-17": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
