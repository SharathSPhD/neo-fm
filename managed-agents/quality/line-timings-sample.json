   }
  ]
 },
 "kn-13": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ಮಳೆಯ ಹನಿ ಕಿಟಕಿ ಮೇಲೆ, ಬಸ್ಸು ಊರ ಕಡೆ ಓಡಿದೆ",
    "startS": 0,
    "endS": 4.8,
    "cer": 0.06451612903225806,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಹಳೆಯ ದಾರಿ ಕರೆದಂತೆ, ವೈಪರಿನ ತಾಳಕೆ ಹಾಡಿದೆ",
    "startS": 5,
    "endS": 10,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ಕೆಂಪು ಮಣ್ಣು ತೋಯ್ದಿರಲು, ಬೆಟ್ಟ ಹಸಿರು ನಗುತಿದೆ",
    "startS": 10,
    "endS": 15,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "ದೂರ ಮನೆಯ ದೀಪ ಕಂಡು, ಕಣ್ಣು ಮಂಜಾಗುತಿದೆ",
    "startS": 15,
    "endS": 20,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "ಚಾಲಕನ ಹಾಡು ಕೇಳಿ, ಹೊರಗೆ ಗಾಳಿ ಬೀಸಿದೆ",
    "startS": 20,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "ಮಳೆಯ ಹನಿ ಕಿಟಕಿಯ ಮೇಲೆ"
   },
   {
    "startS": 2,
    "text": "ಬಸ್ಸು ಊರ ಕಡೆ ಓಡಿದೆ"
   },
   {
    "startS": 5,
    "text": "ಹಳೆಯ ದಾರಿ ಕರೆದಂತೆ"
   },
   {
    "startS": 7,
    "text": "ವೈಪರಿನ ತಾಳಕೆ ಹಾಡಿದೆ"
   },
   {
    "startS": 10,
    "text": "ಕೆಂಪು ಮಣ್ಣು ತೋಯ್ದಿರಲು"
   },
   {
    "startS": 12,
    "text": "ಬೆಟ್ಟ ಹಸಿರು ನಗುತಿದೆ"
   },
   {
    "startS": 15,
    "text": "ದೂರ ಮನೆಯ ದೀಪ ಕಂಡು"
   },
   {
    "startS": 17,
    "text": "ಕಣ್ಣು ಮಂಜಾಗುತಿದೆ"
   },
   {
    "startS": 20,
    "text": "ಚಾಲಕನ ಹಾಡು ಕೇಳಿ"
   },
   {
    "startS": 22,
    "text": "ಹೊರಗೆ ಗಾಳಿ ಬೀಸಿದೆ"
   }
  ]
 },
 "kn-14": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ತಕಧಿಮಿ ತಾಳ ಕೇಳಿ ನರ್ತಕಿಯರು ಬಂದರು",
    "startS": 0.4,
    "endS": 4.9,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಸಂಜೆ ಜರತಾರಿ ಹೊಳೆಯಲಿ ನಲಿದು ಹಾಡೋಣ",
    "startS": 4.9,
    "endS": 9.7,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ಅಭ್ಯಾಸದ ಹೆಜ್ಜೆ ಹೆಜ್ಜೆ ಮತ್ತೆ ಮತ್ತೆ ಹಸನಾಗಲಿ",
    "startS": 9.7,
    "endS": 14.5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "ಹಿಮ್ಮೇಳದ ಸ್ವರ ಸಂತಸ, ಮೈ ಮನ ಹಗುರಾಗಲಿ",
    "startS": 14.5,
    "endS": 19.3,
    "cer": 0,
    "sung": true
   },
   {
    "i": 4,
    "text": "ಸಂಜೆ ಸಭೆಗೆ ಹೊರಟಾಗ ಕಣ್ಣ ಕಾಡಿಗೆ ಮಿನುಗಲಿ",
    "startS": 19.3,
    "endS": 24.1,
    "cer": 0,
    "sung": true
   },
   {
    "i": 5,
    "text": "ಗೆಜ್ಜೆಯ ನಾದ ಗಾಳಿಯಲ್ಲಿ ಹರಡಿ ಎಲ್ಲ ನಲಿಯಲಿ",
    "startS": 24.1,
    "endS": 29,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0.4,
    "text": "ತಕ ಧಿಮಿ ತಾಳ ಕೇಳಿ ನರ್ತಕಿಯರು ಬಂದರು"
   },
   {
    "startS": 4.9,
    "text": "ಸಂಜೆ ಜರತಾರಿ ಹೊಳೆಯಲಿ ನಲಿದು ಹಾಡೋಣ"
   },
   {
    "startS": 9.7,
    "text": "ಅಭ್ಯಾಸದ ಹೆಜ್ಜೆ ಹೆಜ್ಜೆ ಮತ್ತೆ ಮತ್ತೆ ಹಸನಾಗಲಿ"
   },
   {
    "startS": 14.5,
    "text": "ಹಿಮ್ಮೇಳದ ಸ್ವರಸಂತಸ ಮೈಮನ ಹಗುರಾಗಲಿ"
   },
   {
    "startS": 19.3,
