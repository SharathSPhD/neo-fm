 "ta-1": {
  "language": "Tamil",
  "lines": [
   {
    "i": 0,
    "text": "தை பிறந்தது! தை பிறந்தது! துள்ளுது நெஞ்சு,",
    "startS": 0,
    "endS": 4,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "வாசலில் கோலம் பாடுது, பானை பொங்கிப் பொங்குது.",
    "startS": 4,
    "endS": 10,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "பாட்டி கை நீட்டி வைத்தாள் நெற்றியில் திருநீறு,",
    "startS": 10,
    "endS": 15,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "\"நல்லா இரு கண்ணே\"ன்னு நெட்டி முறிச்சாள் மெல்ல.",
    "startS": 15,
    "endS": 21,
    "cer": 0.15789473684210525,
    "sung": true
   },
   {
    "i": 4,
    "text": "கோலப் புள்ளி ஒவ்வொன்றும் கொண்டாட்டக் குறிதான்,",
    "startS": 21,
    "endS": 25,
    "cer": 0,
    "sung": true
   },
   {
    "i": 5,
    "text": "அரிசி மாவில் மயிலும் ஆடி நிக்குது.",
    "startS": 25,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "தை பிறந்தது தை பிறந்தது"
   },
   {
    "startS": 2,
    "text": "துள்ளுது நெஞ்சு"
   },
   {
    "startS": 4,
    "text": "வாசலில் கோலம் பாடுது"
   },
   {
    "startS": 7,
    "text": "பானை பொங்கிப் பொங்குது"
   },
   {
    "startS": 10,
    "text": "பாட்டி கைநீட்டி வைத்தாள்"
   },
   {
    "startS": 12,
    "text": "நெற்றியில் திருநீறு"
   },
   {
    "startS": 15,
    "text": "நல்லா இருக்கண்ணேனு"
   },
   {
    "startS": 18,
    "text": "நெட்டி முறித்தாள் மெல்ல"
   },
   {
    "startS": 21,
    "text": "கோலப்புள்ளி ஒவ்வொன்றும்"
   },
   {
    "startS": 23,
    "text": "கொண்டாட்டக் குறிதான்"
   },
   {
    "startS": 25,
    "text": "அரிசி மாவில் மயிலும்"
   },
   {
    "startS": 28,
    "text": "ஆடி நிக்குது"
   }
  ]
 },
 "ta-10": {
  "language": "Tamil",
  "lines": [
   {
    "i": 0,
    "text": "நகரச் சுமை தாங்கி நான் துயிலும் வேளையில்,",
    "startS": 0,
    "endS": 5,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ஊர்க்கோயில் மணியோசை கனவில் வருகுதே.",
    "startS": 5,
    "endS": 10,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "வயல்வரப்பில் நடந்த பாதம் நினைவில் வாழுதே,",
    "startS": 10,
    "endS": 16,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "அம்மன் சன்னிதி அகல்விளக்கு என் வழி காட்டுதே.",
    "startS": 16,
    "endS": 21,
    "cer": 0.05263157894736842,
    "sung": true
   },
   {
    "i": 4,
    "text": "ஓய்வில்லா ஓட்டத்தில் உன் நாமம் ஒன்றே துணையே,",
    "startS": 21,
    "endS": 26,
    "cer": 0,
    "sung": true
   },
   {
    "i": 5,
    "text": "ஊர் திரும்பும் நாள்வரை காத்தருள்வாய் ஐயனே.",
    "startS": 26,
    "endS": 29.794871794871796,
    "cer": 0.08108108108108109,
    "sung": true
   }
  ],
  "segments": [
   {
    "startS": 0,
    "text": "நகரச் சுமை தாங்கி நான் துயிலும் வேளையில்"
