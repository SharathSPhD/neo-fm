    "text": "ಹಸಿರು ಹೊಲದ ಗಾಳಿಯೇ, ಹೊಸ ಊರಿಗೆ ಬಾ ಜೊತೆಗೆ",
    "startS": 21,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
