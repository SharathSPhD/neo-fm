 "kn-10": {
  "language": "Kannada",
  "lines": [
   {
    "i": 0,
    "text": "ದೇವರೇ ಕಾಯೋ ನಮ್ಮ ಯೋಧನ ಹೆಜ್ಜೆಯ",
    "startS": 0,
    "endS": 5.88,
    "cer": 0,
    "sung": true
   },
   {
    "i": 1,
    "text": "ಎದೆಯಲಿ ಹೆಮ್ಮೆ, ಮೌನದ ಪ್ರಾರ್ಥನೆಯ",
    "startS": 5.88,
    "endS": 11.318666666666665,
    "cer": 0,
    "sung": true
   },
   {
    "i": 2,
    "text": "ಅಪ್ಪನ ಬೆನ್ನು ನೆಟ್ಟಗೆ, ಅಮ್ಮನ ದೀಪ ಮಿನುಗಿದೆ",
    "startS": 11.52,
    "endS": 17,
    "cer": 0,
    "sung": true
   },
   {
    "i": 3,
    "text": "ಮನೆಮುಂದಿನ ತುಳಸಿ ಕಟ್ಟೆ ಅವನ ಹೆಸರ ಹಾಡಿದೆ",
    "startS": 17,
    "endS": 22.42,
    "cer": 0.0625,
    "sung": true
   },
   {
    "i": 4,
    "text": "ಊರು ಕೇಳದೆ ಹೊಗಳದೆ ನಮ್ಮ ಹೆಮ್ಮೆ ಬೆಳಗುತಿದೆ",
    "startS": 22.64,
    "endS": 30,
    "cer": 0,
    "sung": true
   }
  ],
  "segments": [
